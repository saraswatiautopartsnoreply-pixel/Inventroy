{
  "name": "inventory-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:full": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"vite --host 0.0.0.0\"",
    "start": "node server/index.js",
    "seed:demo": "node server/seed.js",
    "migrate:categories": "node server/migrations/backfill-product-categories.js",
    "migrate:product-ids": "node server/migrations/migrate-product-numbers.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.74.0",
    "mongoose": "^9.12.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
