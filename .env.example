NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/stockroom?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
SEARCH_CACHE_TTL_SECONDS=15
SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
VAPID_PUBLIC_KEY=generate-a-vapid-public-key
VAPID_PRIVATE_KEY=generate-a-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourcompany.com

# WooCommerce is read-only. Keep all credentials on the server.
WOOCOMMERCE_URL=https://shop.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me
WOOCOMMERCE_DEFAULT_WAREHOUSE=KG
WOOCOMMERCE_DEFAULT_RACK=G-1A

# Razorpay Payment Links. Start with test-mode credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Backblaze B2 packing photos and videos. Keep these keys server-side only.
# Use a private bucket and an app key restricted to this bucket and the packing-media/ prefix.
# Required app-key capabilities: readFiles, writeFiles, and deleteFiles.
BACKBLAZE_KEY_ID=replace_me
BACKBLAZE_APPLICATION_KEY=replace_me
BACKBLAZE_BUCKET_ID=replace_me
